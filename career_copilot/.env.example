# Career Copilot — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!

# Google Gemini API
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your_google_api_key_here

# Model chain with automatic standby failover
# Primary model; on quota/5xx/connection failure the standby model is used automatically.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STANDBY_MODEL=gemini-2.0-flash

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Resume / Personal Info
RESUME_NAME=Your Name
RESUME_LINKEDIN=https://www.linkedin.com/in/your-profile/
RESUME_GITHUB=https://github.com/your-username
RESUME_PORTFOLIO=https://your-portfolio.com
# Optional: GitHub username for the profile optimizer (falls back to parsing RESUME_GITHUB)
GITHUB_USERNAME=your-username
RESUME_EMAIL=your.email@example.com
RESUME_PHONE=+91-0000000000

# Job Search Settings
MIN_MATCH_PERCENTAGE=40
EXPERIENCE_LEVEL=fresher
EXCLUDE_KEYWORDS=
JOB_SEARCH_QUERY=Python Developer

# Email (SMTP Configuration — Gmail App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=your.email@example.com

# WhatsApp (Meta Developer Portal Credentials)
WHATSAPP_TOKEN=your_meta_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_TO_NUMBER=your_recipient_phone_number
